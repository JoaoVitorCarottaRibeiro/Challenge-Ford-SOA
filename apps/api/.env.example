# Banco Oracle (FIAP)
DB_HOST=
DB_PORT=1521
DB_USER=
DB_PASS=
DB_SERVICE=ORCL

# Agente de IA
ANTHROPIC_API_KEY=

# Assinatura HMAC do corpo das requisições de escrita (POST/DELETE).
# Precisa ser IDÊNTICO ao NEXT_PUBLIC_HMAC_SECRET em apps/web/.env.local.
HMAC_SECRET=

# Assinatura dos tokens JWT (login/refresh).
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Chave de criptografia do payload do audit log (AES-256, 32 caracteres).
ENCRYPTION_KEY=

# Senha mestra exigida em POST /api/auth/register (adminKey) para criar o primeiro usuário.
API_KEY=

# Porta da API (opcional, padrão 3333)
PORT=3333

# Origens extras liberadas no CORS, além de localhost/127.0.0.1/192.168.x.x (opcional, separadas por vírgula)
ALLOWED_ORIGINS=
