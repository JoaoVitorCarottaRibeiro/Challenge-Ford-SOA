# URL da API (Fastify), incluindo o prefixo /api.
# No emulador Android, "localhost" aponta pro próprio emulador, não pro seu PC —
# use 10.0.2.2 (Android Studio) ou o IP da sua máquina na rede local (ex.: 192.168.x.x,
# mostrado no terminal quando você roda "pnpm dev:api"). No Expo Go em celular físico,
# use sempre o IP da rede local.
EXPO_PUBLIC_API_URL=http://localhost:3333/api

# Precisa ser IDÊNTICO ao HMAC_SECRET em apps/api/.env
EXPO_PUBLIC_HMAC_SECRET=
